# ==============================================================================
# Artisan AI — Production & Cloud Environment Configuration (.env.example)
# ==============================================================================

# 1. Environment Mode
# Set to 'production' when deploying on Render, Railway, Vercel, or AWS
ENVIRONMENT=production

# 2. Database (PostgreSQL is required for production)
# Example PostgreSQL connection string (Replace with actual connection details):
DATABASE_URL=postgresql://db_user:db_password@your-db-host.example.com:5432/artisan_db?sslmode=require

# 3. Security (JWT Authentication)
# Generate a strong 256-bit random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_secure_production_secret_key_at_least_64_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. CORS & Network
# Comma-separated list of allowed production frontend domains (do not include localhost in production)
CORS_ORIGINS=https://your-app-domain.com
HOST=0.0.0.0
PORT=8000

# 5. Multimodal AI Engine (Google Gemini 3.6 Flash)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash-lite,gemini-2.5-flash,gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=25.0

# 6. Market Research API & Search Strategy Configuration
MARKET_RESEARCH_PROVIDER=WEB_SEARCH
MARKET_RESEARCH_API_KEY=your_optional_serper_api_key_here
MARKET_SEARCH_COUNTRY=IN
MARKET_SEARCH_LANGUAGE=en
MARKET_SEARCH_MAX_RESULTS=10

# 7. Pricing Engine Business Rule Constants
PRICING_MIN_MARGIN_PCT=0.20
PRICING_MARKET_MEDIAN_WEIGHT=0.30
PRICING_MAX_UPWARD_ADJUSTMENT_PCT=0.25
PRICING_MAX_DOWNWARD_ADJUSTMENT_PCT=0.10
PRICING_MIN_DEMAND_FACTOR=0.95
PRICING_MAX_DEMAND_FACTOR=1.15

# 8. Frontend API Base
VITE_API_BASE=/api

# 9. ONDC Retail Seller-Side Integration (Beckn Protocol v1.2)
# Environment modes: development, staging, preproduction, production
ONDC_ENVIRONMENT=development
# Participant / Subscriber ID registered on ONDC Registry (placeholder for staging onboarding)
ONDC_SUBSCRIBER_ID=artisan-ai-bpp.example.com
# Key ID registered with ONDC Registry
ONDC_UNIQUE_KEY_ID=key-1
# Ed25519 Public Key (Base64 encoded 32 bytes)
ONDC_PUBLIC_KEY=your_base64_ed25519_public_key_here
# Ed25519 Private Key (Base64 encoded 32 bytes - NEVER commit real private keys)
ONDC_PRIVATE_KEY=your_base64_ed25519_private_key_here
# Gateway URL for ONDC network (e.g. https://staging.gateway.ondc.org)
ONDC_GATEWAY_URL=https://staging.gateway.ondc.org
# Public base URL of this Artisan AI BPP instance
ONDC_BPP_URI=https://artisan-ai.example.com/ondc
# Domain category: ONDC:RET12 (Handicrafts/Fashion), ONDC:RET15 (Home & Decor), etc.
ONDC_DOMAIN=ONDC:RET12
ONDC_CITY=std:080
ONDC_COUNTRY=IND
ONDC_ENFORCE_AUTH=false

