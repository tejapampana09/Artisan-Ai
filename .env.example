# ==============================================================================
# Artisan AI — Production & Cloud Environment Configuration (.env.example)
# ==============================================================================

# 1. Environment Mode
# Set to 'production' when deploying on Render, Railway, Vercel, or AWS
ENVIRONMENT=production

# 2. Database (PostgreSQL is required for production)
# Example PostgreSQL connection string (Replace with actual connection details):
DATABASE_URL=postgresql://db_user:db_password@your-db-host.example.com:5432/artisan_db?sslmode=require

# 3. Security (JWT Authentication)
# Generate a strong 256-bit random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_secure_production_secret_key_at_least_64_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. CORS & Network
# Comma-separated list of allowed production frontend domains (do not include localhost in production)
CORS_ORIGINS=https://your-app-domain.com
HOST=0.0.0.0
PORT=8000

# 5. Multimodal AI Engine (Google Gemini 2.5 Flash)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=15.0

# 6. Frontend API Base
# Note: Using VITE_API_BASE=/api requires reverse proxy / URL rewrite configuration (e.g. Nginx, Cloudflare, or vercel.json rewrites)
VITE_API_BASE=/api

