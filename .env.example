# ==============================================================================
# ARTISAN AI — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# in your cloud hosting provider (Render, Railway, Fly.io, AWS, GCP, Vercel).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | staging | production
# In production, strict security checks are enforced:
# - SQLite is rejected (PostgreSQL required)
# - DEMO_MODE must be false
# - JWT_SECRET_KEY must be strong and unpredictable
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. DEMO MODE & EVALUATION BYPASS
# ------------------------------------------------------------------------------
# When true:
# - Automatically seeds sample artisan products on first startup
# - Allows local development testing without strict bearer auth headers
# Set to false for real multi-tenant SaaS production usage.
DEMO_MODE=true

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Development (SQLite):
DATABASE_URL=sqlite:///./artisan_ai.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql://artisan_user:your_secure_db_password@localhost:5432/artisan_ai_db

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (HMAC-SHA256).
# Generate a strong 64-char key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=artisan_ai_dev_secret_key_marginalized_artisans_safety_first

# Signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. CORS ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# In development, localhost origins are permitted by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# API Key from Google AI Studio (https://aistudio.google.com/)
# Used for voice cataloging, title generation, craft storytelling, and pricing suggestions.
# If left empty, the application uses high-accuracy craft domain fallbacks.
GEMINI_API_KEY=

# Maximum seconds to wait for AI responses before falling back to local domain model
AI_REQUEST_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 7. SERVER HOST & PORT
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 8. FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Base URL for API requests made by the frontend.
# In local dev with Vite proxy, '/api' is recommended.
# In decoupled production deployments (e.g. Vercel + Render), set to:
# VITE_API_BASE=https://api.yourdomain.com/api
VITE_API_BASE=/api
