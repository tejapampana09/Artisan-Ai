# ===============================================
# Artisan AI Environment Configuration
# ===============================================

# App Environment: development | production
ENVIRONMENT=development

# Demo Mode: Allows offline/demo user auto-provisioning and baseline seed data in development.
# STRICT SAFETY RULE: DEMO_MODE must be false in production!
DEMO_MODE=true

# Database Connection:
# Development (SQLite default):
DATABASE_URL=sqlite:///./artisan_ai.db
# Production (PostgreSQL required):
# DATABASE_URL=postgresql://artisan_user:secure_password@localhost:5432/artisan_ai_prod

# JWT Authentication Secrets
# In development: fallback key is permitted.
# In production: MUST be set to a secure, unpredictable 32+ char secret.
JWT_SECRET_KEY=dev_artisan_jwt_secret_change_me_in_production_key_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Google Gemini API Key (Optional: Live AI will activate when set; deterministic fallback used if absent)
GEMINI_API_KEY=

# Production Database Migration Command:
# Run: alembic upgrade head
