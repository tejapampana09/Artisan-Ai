# App Environment: development | production
ENVIRONMENT=development

# Database Connection (Defaults to SQLite for local development / hackathon MVP)
DATABASE_URL=sqlite:///./artisan_ai.db

# JWT Security Secrets (Change in production!)
JWT_SECRET_KEY=sih_2026_artisan_ai_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Google Gemini API Key (Optional: Live AI will activate when set; deterministic fallback used if absent)
GEMINI_API_KEY=
