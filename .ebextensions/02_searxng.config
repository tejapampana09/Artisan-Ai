option_settings:
  aws:elasticbeanstalk:application:environment:
    SEARXNG_SECRET: ""

files:
  "/etc/searxng/settings.yml":
    mode: "000644"
    owner: root
    group: root
    content: |
      use_default_settings: true
      server:
        limiter: false
        image_proxy: false
      search:
        safe_search: 0
        autocomplete: ""
        default_lang: "en"
        formats:
          - html
          - json

commands:
  01_install_docker:
    command: "dnf install -y docker || yum install -y docker || true"
  02_start_docker:
    command: "systemctl enable docker && systemctl start docker"
  03_run_searxng_container:
    command: |
      docker stop searxng || true
      docker rm searxng || true
      SEARXNG_SECRET=$(/opt/elasticbeanstalk/bin/get-config environment -k SEARXNG_SECRET 2>/dev/null || /opt/elasticbeanstalk/bin/get-config environment -k SEARXNG_SECRET_KEY 2>/dev/null || true)
      if [ -z "$SEARXNG_SECRET" ]; then
        SEARXNG_SECRET=$(openssl rand -hex 32 2>/dev/null || python3 -c "import secrets; print(secrets.token_hex(32))" 2>/dev/null || head -c 64 /dev/urandom | tr -dc 'a-f0-9' || true)
      fi
      docker run -d --name searxng --restart=always \
        -p 127.0.0.1:8080:8080 \
        -e SEARXNG_SECRET="$SEARXNG_SECRET" \
        -v /etc/searxng/settings.yml:/etc/searxng/settings.yml:ro \
        searxng/searxng:2026.9.15-ca4965040

