files:
  "/etc/searxng/settings.yml":
    mode: "000644"
    owner: root
    group: root
    content: |
      use_default_settings: true
      server:
        secret_key: "artisan_ai_searxng_secret_key_marginalized_artisans"
        limiter: false
        image_proxy: false
      search:
        safe_search: 0
        autocomplete: ""
        default_lang: "en"
        formats:
          - html
          - json

commands:
  01_install_docker:
    command: "dnf install -y docker || yum install -y docker || true"
  02_start_docker:
    command: "systemctl enable docker && systemctl start docker"
  03_run_searxng_container:
    command: |
      docker stop searxng || true
      docker rm searxng || true
      docker run -d --name searxng --restart=always -p 8080:8080 -v /etc/searxng/settings.yml:/etc/searxng/settings.yml:ro searxng/searxng:latest
