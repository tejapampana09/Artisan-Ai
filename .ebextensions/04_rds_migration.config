# .ebextensions/04_rds_migration.config
#
# EB Leader-Only RDS Schema Migration Hook
# -----------------------------------------
# Runs `alembic upgrade head` on the EC2 leader instance during deployment.
# This is belt-and-suspenders: the GitHub Actions migrate-rds job runs first,
# but this ensures correctness on fresh EB instance provisioning / scale-out.
#
# container_commands run AFTER the app is staged but BEFORE the web server starts.
# "leader_only: true" ensures only the first EC2 instance in the environment runs it.

container_commands:
  01_alembic_upgrade:
    command: |
      if [ -f "/var/app/staging/alembic.ini" ] && [ -n "$DATABASE_URL" ] && [[ "$DATABASE_URL" != *"your-rds-endpoint"* ]] && [[ "$DATABASE_URL" == postgresql* ]]; then
        source /var/app/venv/*/bin/activate || true
        cd /var/app/staging
        echo "[EB Migration] Running alembic upgrade head at $(date -u)"
        python -m alembic upgrade head
        python -m alembic current
      else
        echo "[EB Migration] Skipping alembic upgrade: valid remote PostgreSQL DATABASE_URL or alembic.ini not present."
      fi
    leader_only: true
    env:
      PYTHONPATH: "/var/app/staging"

