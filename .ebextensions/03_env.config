option_settings:
  aws:elasticbeanstalk:application:environment:
    MARKET_RESEARCH_PROVIDER: "SEARXNG"
    SEARXNG_BASE_URL: "http://localhost:8080"
    GEMINI_MODEL: "gemini-3.1-flash-lite"
    GEMINI_FALLBACK_MODELS: "gemini-3.6-flash,gemini-3.5-flash"
    MARKET_SEARCH_GEMINI_MODEL: "gemini-3.1-flash-lite"
    MARKET_SEARCH_GEMINI_FALLBACK_MODELS: "gemini-3.6-flash,gemini-3.5-flash"
    AI_REQUEST_TIMEOUT_SECONDS: "10.0"
